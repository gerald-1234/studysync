NODE_ENV=development
PORT=5000

# Comma-separated frontend URLs that may call the API.
CLIENT_URL=http://localhost:5500,http://127.0.0.1:5500

# Supabase project settings. The secret key must stay on the backend.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SECRET_KEY=your-supabase-secret-key

# Use a long random value with at least 32 characters.
JWT_SECRET=replace-this-with-a-long-random-secret
JWT_EXPIRES_IN=8h

# Used by npm run create-admin. Change these before creating the account.
ADMIN_FIRST_NAME=System
ADMIN_LAST_NAME=Administrator
ADMIN_EMAIL=admin@studysync.local
ADMIN_PASSWORD=ChangeMe123
